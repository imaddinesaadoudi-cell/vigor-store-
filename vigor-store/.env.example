# VIGOR Calisthenics Gear - Google Sheets Integration
# Rename this file to .env and fill in your actual Web App URL

# Google Apps Script Web App Deployment URL
GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec"

# Sheet Name inside your Google Spreadsheet
GOOGLE_SHEET_NAME="Vigor_Orders"
